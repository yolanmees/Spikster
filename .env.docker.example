# Docker Environment Configuration for Spikster
# Copy this file to .env and customize for your environment

# Application
APP_NAME="Spikster"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker Configuration
DOCKERFILE=Dockerfile.dev
PHP_VERSION=8.4
APP_PORT=8000

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=spikster
DB_USERNAME=spikster
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache, Queue, Session
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Mail (MailHog for development)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Development Tools Ports
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
PHPMYADMIN_PORT=8080
REDIS_COMMANDER_PORT=8081

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Broadcasting
BROADCAST_DRIVER=log

# Spikster Specific
CIPI_NAME="Spikster"
CIPI_WEBSITE="https://spikster.dev"
CIPI_JWT_SECRET=your-jwt-secret-here-change-in-production
CIPI_JWT_ACCESS=3600
CIPI_JWT_REFRESH=604800

# Security
SECURITY_AUDIT_LOG_RETENTION_DAYS=90
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION=300

# SSH Configuration
SSH_DEFAULT_PORT=22
SSH_TIMEOUT=30

# Queue Workers
QUEUE_WORKERS=2
