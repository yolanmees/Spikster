# ===========================================================================
# Spikster Control Panel — Environment Configuration
# ===========================================================================
# Copy to .env and fill in your values. Never commit .env to source control.

# Application
APP_NAME="Spikster Control Panel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spikster
DB_USERNAME=spikster
DB_PASSWORD=dbpass

# Queue
QUEUE_CONNECTION=database

# Cache / Session
CACHE_DRIVER=file
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Spikster Daemon — shared secret with the Go daemon
# Generated by `spikster install`, stored in /etc/spikster/daemon.token
DAEMON_TOKEN=

# Spikster Defaults
SPIKSTER_DEFAULT_PHP=8.3
SPIKSTER_USERS_PREFIX=sp

# Panel Settings (config/cipi.php)
CIPI_USERNAME=admin@localhost
CIPI_PASSWORD=password
CIPI_NAME="Spikster Control Panel"
CIPI_WEBSITE=https://spikster.com
CIPI_DOCUMENTATION=https://spikster.com/docs
CIPI_ACTIVESETUPCOUNT=/#
CIPI_APP=/#
CIPI_USERS_PREFIX=sp

# JWT Authentication
JWT_SECRET=
JWT_ACCESS=900
JWT_REFRESH=7200
JWT_ACCESS_LIFETIME=3600
JWT_REFRESH_LIFETIME=604800

# Panel Server (set by go.sh during install)
PANEL_SERVER_ID=
PANEL_SERVER_IP=
PANEL_SERVER_PASS=
PANEL_SERVER_DB=

# Monitoring Agent (config/monitoring.php)
MONITORING_AGENT_PORT=9273
MONITORING_COLLECTION_INTERVAL=60
MONITORING_RETENTION_DAYS=30
MONITORING_AGENT_TIMEOUT=10
MONITORING_USE_CACHED=true

# Alert thresholds (%)
THRESHOLD_CPU_WARNING=70
THRESHOLD_CPU_CRITICAL=90
THRESHOLD_MEMORY_WARNING=80
THRESHOLD_MEMORY_CRITICAL=95
THRESHOLD_DISK_WARNING=80
THRESHOLD_DISK_CRITICAL=90

# Chart defaults
MONITORING_CHART_HOURS=24
MONITORING_CHART_MAX_POINTS=100

# Security (config/security.php)
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false
SESSION_TIMEOUT=120
SESSION_STRICT_MODE=true
API_RATE_LIMIT=60
MAX_UPLOAD_SIZE=10240
SCAN_UPLOADS=false
IP_WHITELIST=
IP_BLACKLIST=
ENABLE_IP_WHITELIST=false
AUDIT_LOGGING=true
