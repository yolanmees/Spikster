FROM php:8.3-fpm-alpine

# Development build - Install system dependencies
RUN apk add --no-cache \
    bash \
    vim \
    git \
    curl \
    wget \
    unzip \
    zip \
    nano \
    supervisor \
    nginx \
    nodejs \
    npm \
    # Build dependencies for PHP extensions
    $PHPIZE_DEPS \
    linux-headers \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    libzip-dev \
    icu-dev \
    postgresql-dev \
    oniguruma-dev \
    libxml2-dev

# Install PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
    pdo_mysql \
    pdo_pgsql \
    mysqli \
    bcmath \
    gd \
    zip \
    intl \
    opcache \
    pcntl \
    sockets \
    soap \
    exif

# Install Redis extension via PECL
RUN pecl install redis \
    && docker-php-ext-enable redis

# Configure PHP for development
RUN echo "memory_limit = 512M" > /usr/local/etc/php/conf.d/99-spikster.ini && \
    echo "upload_max_filesize = 256M" >> /usr/local/etc/php/conf.d/99-spikster.ini && \
    echo "post_max_size = 256M" >> /usr/local/etc/php/conf.d/99-spikster.ini && \
    echo "max_execution_time = 300" >> /usr/local/etc/php/conf.d/99-spikster.ini && \
    echo "max_input_time = 300" >> /usr/local/etc/php/conf.d/99-spikster.ini && \
    echo "display_errors = On" >> /usr/local/etc/php/conf.d/99-spikster.ini && \
    echo "error_reporting = E_ALL" >> /usr/local/etc/php/conf.d/99-spikster.ini

# Install Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Configure Nginx and Supervisor directories
RUN mkdir -p /run/nginx && \
    mkdir -p /var/www/html && \
    mkdir -p /var/log/supervisor

# Set working directory
WORKDIR /var/www/html

# Copy application files
COPY . /var/www/html

# Copy Nginx config
COPY docker/nginx/default.conf /etc/nginx/http.d/default.conf

# Copy Supervisor config
COPY docker/supervisor/supervisord.conf /etc/supervisord.conf

# Set permissions
RUN chown -R www-data:www-data /var/www/html 2>/dev/null || chown -R nginx:nginx /var/www/html && \
    chmod -R 755 /var/www/html && \
    chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache 2>/dev/null || true && \
    mkdir -p /var/www/html/database && \
    touch /var/www/html/database/database.sqlite && \
    chmod 777 /var/www/html/database && \
    chmod 666 /var/www/html/database/database.sqlite

# Install Composer dependencies (dev)
RUN composer install --no-interaction --prefer-dist

# Install NPM dependencies (dev)
RUN npm ci --include=dev

# Expose ports
EXPOSE 80 9000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD curl -f http://localhost/up || exit 1

# Start Supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
